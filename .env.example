# Local — SQLite (default)
DATABASE_URL="file:./prisma/dev.db"

# Google OAuth login (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application). Redirect URIs: <app-url>/api/auth/callback/google
# and, for Google Sheets sync, <app-url>/api/integrations/google/callback
# (enable the Google Sheets API; the scope DevChat asks for is drive.file only).
GOOGLE_OAUTH_CLIENT_ID="..."
GOOGLE_OAUTH_CLIENT_SECRET="..."
AUTH_SECRET="..."   # generate with: openssl rand -base64 32

# Production — PostgreSQL (Vercel Postgres / Neon)
# DATABASE_URL="postgresql://user:password@ep-abc123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── LLM providers (bring your own key) ──────────────────────────────────────
# Every key here is optional. Any provider with a key is auto-detected and its
# live model list appears in the model picker. Users can also add their own
# keys in Settings; a key saved there overrides the env var for that user, so a
# shared deployment (e.g. Vercel) works with no keys set at all.
OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"   # point OpenAI at a proxy
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="AIza..."             # Google AI Studio (Gemini)
OPENROUTER_API_KEY="sk-or-..."       # OpenRouter gateway — free models only by default
NVIDIA_NIM_API_KEY="nvapi-..."       # NVIDIA NIM hosted models
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Any other OpenAI-compatible server: Groq, Together, DeepSeek, xAI, Mistral,
# LM Studio, vLLM, LiteLLM, a remote Ollama (http://host:11434/v1) ...
# CUSTOM_BASE_URL="https://api.groq.com/openai/v1"
# CUSTOM_API_KEY="..."                # optional for local servers

# "Scan this machine" in Settings finds keys saved by other local tools. On by
# default under `npm run dev`; set this to enable it for a local `npm start`.
# Never enable on a shared server — it reads the server user's home directory.
# ALLOW_PROVIDER_DETECTION=1

# Who may use this machine's own tools: Claude Code and the other CLI models, their working folders,
# "Scan this machine", and the Claude files page. Comma-separated sign-in emails. Unset = every signed-in
# user, which is right for one developer on their own laptop and unsafe on a shared server.
# OWNER_EMAILS=

# Web Search
TAVILY_API_KEY="tvly-..."    # Optional, falls back to DuckDuckGo

# Local Models (auto-detected when reachable)
OLLAMA_BASE_URL="http://localhost:11434"
EMBED_MODEL="nomic-embed-text"   # Model used for RAG embeddings
