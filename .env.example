# Required — Vercel Postgres (Neon) connection string
# For local dev, use a local PostgreSQL or a Neon free-tier DB
DATABASE_URL="postgresql://user:password@ep-abc123.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-abc123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Provider API Keys (at least one required)
