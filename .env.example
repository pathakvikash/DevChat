# Local — SQLite (default)
DATABASE_URL="file:./prisma/dev.db"

# Google OAuth login (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application). Redirect URI: <app-url>/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID="..."
GOOGLE_OAUTH_CLIENT_SECRET="..."
AUTH_SECRET="..."   # generate with: openssl rand -base64 32

# Production — PostgreSQL (Vercel Postgres / Neon)
# DATABASE_URL="postgresql://user:password@ep-abc123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Provider API Keys (at least one required)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="..."
OPENROUTER_API_KEY="sk-or-..."   # OpenRouter gateway — gives access to 300+ models
NVIDIA_NIM_API_KEY="nvapi-..."   # NVIDIA NIM — hosted NVIDIA models

# Web Search
TAVILY_API_KEY="tvly-..."    # Optional, falls back to DuckDuckGo

# Local Models
OLLAMA_BASE_URL="http://localhost:11434"
EMBED_MODEL="nomic-embed-text"   # Model used for RAG embeddings
