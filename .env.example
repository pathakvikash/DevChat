# Required
DATABASE_URL="file:./prisma/dev.db"

# AI Provider API Keys (at least one required)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="..."
OPENROUTER_API_KEY="sk-or-..."   # OpenRouter gateway — gives access to 300+ models
NVIDIA_NIM_API_KEY="nvapi-..."   # NVIDIA NIM — hosted NVIDIA models

# Web Search
TAVILY_API_KEY="tvly-..."    # Optional, falls back to DuckDuckGo

# Local Models
OLLAMA_BASE_URL="http://localhost:11434"
EMBED_MODEL="nomic-embed-text"   # Model used for RAG embeddings
