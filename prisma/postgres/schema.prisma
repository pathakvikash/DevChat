generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (NextAuth v5) models ───────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]

  conversations  Conversation[]
  knowledgeBases KnowledgeBase[]
  memories       Memory[]
  mcpServers     McpServer[]
  personas       Persona[]
  appSettings    AppSetting[]
  traces         Trace[]
  workflows      Workflow[]
  workflowRuns   WorkflowRun[]
  dataTables     DataTable[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id                       String     @id @default(cuid())
  userId                   String?
  title                    String     @default("New Chat")
  model                    String     @default("gpt-4o")
  persona                  String?
  systemPrompt             String?
  kbId                     String?
  webSearch                Boolean    @default(false)
  totalTokens              Int        @default(0)
  temperature              Float      @default(0.7)
  maxTokens                Int?
  contextLength            Int?
  topP                     Float?
  compressedSummary        String?
  compressedAt             DateTime?
  compressedBeforeTokens   Int?
  compressedAfterTokens    Int?
  compressedBeforeMessages Int?
  chatOnlyMode             Boolean    @default(false)
  memoryDisabled           Boolean    @default(false)
  generativeUiEnabled      Boolean    @default(false)
  temporary                Boolean    @default(false) // hidden from lists, memory off, deleted on leave or after 24h
  maxToolCalls     Int          @default(5)
  reasoningEffort  String? // low | medium | high | max; honored by reasoning-capable providers (Claude Code --effort, Codex, OpenCode --variant)
  workingFolder    String? // CLI-backed models only: folder the tool may read (chat mode) or edit (agent mode); null = sandboxed
  fallbackModel    String? // Optional backup model tried when the primary fails (rate limit, outage, auth).
   note                     String?
   pinned                   Boolean    @default(false)
   archived                 Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  user                     User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages                 Message[]
  artifacts                Artifact[]
  todos                    Todo[]
  forkedFromId             String?
  forkedFrom               Conversation? @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks                    Conversation[] @relation("Forks")
  queuedMessages           QueuedMessage[]
  parentId                 String?
  kind                     String     @default("main") // main | side | subagent
  parent                   Conversation?  @relation("Children", fields: [parentId], references: [id], onDelete: Cascade)
  children                 Conversation[] @relation("Children")

  @@index([updatedAt])
  @@index([userId])
  @@index([parentId])
}

// Messages typed while a reply runs. Deleted or delivered (deliveredAt set) before the next step.
model QueuedMessage {
  id             String       @id
  conversationId String
  text           String
  seq            Int          @default(0) // client order within the chat; claims read rows in this order
  createdAt      DateTime     @default(now())
  deliveredAt    DateTime?
  claimToken     String? // set while one step's claim holds the row; unique per claim
  agent          String? // JSON of AgentMessageData for a message sent from another chat; null for the user's own
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, deliveredAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  systemPrompt   String?
  parts          String?
  attachments    String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  model          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       Feedback?

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  messageId String   @unique
  rating    Int      // 1 = thumbs up (good), -1 = thumbs down (bad)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id          String     @id @default(cuid())
  userId      String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]

  @@index([userId])
}

model Document {
  id            String        @id @default(cuid())
  kbId          String
  filename      String
  content       String
  chunks        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([kbId])
}

model Persona {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  description  String
  systemPrompt String
  isBuiltIn    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Memory {
  id                   String    @id @default(cuid())
  userId               String?
  key                  String
  value                String
  category             String    @default("general")
  // --- Lifecycle / salience: lets memory improve over time ---
  // How confident we are this fact is true & worth keeping (0..1). Reinforced
  // when re-observed, decayed by consolidation when stale.
  confidence           Float     @default(0.6)
  // How many times this fact has been surfaced into a prompt. Frequently used
  // facts rank higher and survive pruning.
  useCount             Int       @default(0)
  // Last time this fact was injected into a model prompt.
  lastUsedAt           DateTime?
  // Conversation that first produced/confirmed this fact (provenance).
  sourceConversationId String?
  pinned               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([category])
  @@index([userId])
}



// A per-conversation todo item. Created either by the AI via the createTodo
// tool or manually by the user. The model can update status via updateTodoStatus.
model Todo {
  id             String       @id @default(cuid())
  conversationId String
  title          String
  description    String?
  status         String       @default("pending") // pending | in_progress | done | cancelled
  priority       String       @default("medium") // low | medium | high
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, status])
}

// An MCP (Model Context Protocol) server connection. Each server exposes
// tools dynamically that can be toggled on/off per-conversation.
model McpServer {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  url         String   // The MCP server endpoint URL
  authType    String   @default("none") // none | apikey | oauth2
  authConfig  String?  // JSON: { apiKey?, clientId?, clientSecret?, scopes? }
  authToken   String?  // Encrypted OAuth2 access/refresh token JSON
  enabled     Boolean  @default(false)
  lastPingAt  DateTime?
  errorMsg    String?  // Last connection error
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Artifact {
  id             String       @id @default(cuid())
  conversationId String
  type           String
  title          String
  content        String
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Server-side settings store (API keys, default model, search provider, etc.), scoped per user.
model AppSetting {
  id        String   @id @default(cuid())
  userId    String?
  key       String
  value     String
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ─── Observability: per-request generation traces ──────────────────────────
// One Trace row per chat completion request (a single assistant turn, possibly
// spanning many tool-call steps). Captures latency, token usage, estimated
// cost, and outcome so we can monitor the system without an external service.
model Trace {
  id             String          @id @default(cuid())
  userId         String?
  conversationId String?
  model          String
  provider       String?
  promptTokens   Int             @default(0)
  completionTokens Int           @default(0)
  totalTokens    Int             @default(0)
  cost           Float? // estimated USD; null when pricing is unknown
  latencyMs      Int
  firstTokenMs   Int? // time-to-first-token
  steps          Int?
  finishReason   String?
  status         String          @default("success") // success | error | aborted | truncated
  errorMsg       String?
  inputChars     Int?
  outputChars    Int?
  createdAt      DateTime        @default(now())
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls      TraceToolCall[]

  @@index([createdAt])
  @@index([model])
  @@index([status])
  @@index([conversationId])
  @@index([userId])
}

// One row per tool invocation within a trace (for per-tool latency/cost drill-down).
model TraceToolCall {
  id        String   @id @default(cuid())
  traceId   String
  toolName  String
  input     String? // JSON, truncated
  output    String? // JSON/text, truncated
  ok        Boolean  @default(true)
  latencyMs Int?
  createdAt DateTime @default(now())
  trace     Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
}

// ─── Workflows: a flow of cards that runs on the server (docs/design/workflows.md) ───
// JSON is stored as TEXT so both schemas stay identical.
model Workflow {
  id        String        @id @default(cuid())
  userId    String
  name      String        @default("Untitled workflow")
  graph     String // JSON WorkflowGraph
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@index([userId, updatedAt])
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowId   String
  userId       String // duplicated for ownership checks and the per-user run cap
  trigger      String    @default("manual") // manual | schedule (later)
  state        String // running | waiting | succeeded | failed | cancelled | interrupted
  graph        String // snapshot at start; edits during a run apply to the next one
  nodes        String    @default("{}") // JSON Record<cardId, CardRun>
  error        String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  attempt      Int       @default(0) // bumped by Resume; every save of an older loop then matches no row
  heartbeatAt  DateTime  @default(now())
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
  @@index([userId, state])
}

// ─── Data tables (phase 2): a DevChat table that a workflow's Save to table card writes to. ───
// Named "DataTable" so it is not confused with the generative-UI Table component.
model DataTable {
  id        String         @id @default(cuid())
  userId    String
  name      String
  columns   String         @default("[]") // JSON [{ key, label, type: text|longtext|url|number|date }]
  statuses  String         @default("[\"new\"]") // JSON status options, in order
  privateFrom String @default("") // kinds of private data it was filled from, comma separated (chats, later mcp and folder); empty = public
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows      DataTableRow[]

  @@unique([userId, name])
}

model DataTableRow {
  id        String    @id @default(cuid())
  tableId   String
  key       String? // dedupe key (a normalised URL for jobs and news)
  status    String    @default("new")
  data      String // JSON object: column key → value
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  table     DataTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, key])
  @@index([tableId, status])
}
