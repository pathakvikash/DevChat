{
  "name": "devchat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npx tsx scripts/seed.ts",
    "vercel-build": "cp prisma/postgres/schema.prisma prisma/schema.prisma && rm -rf prisma/migrations && cp -r prisma/postgres/migrations prisma/migrations && prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.78",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/react": "^3.0.179",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "ai": "^6.0.177",
    "better-sqlite3": "^12.10.0",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.40.0",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
    "mermaid": "^11.16.0",
    "next": "16.2.6",
    "ollama-ai-provider-v2": "3.5.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "npx tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
